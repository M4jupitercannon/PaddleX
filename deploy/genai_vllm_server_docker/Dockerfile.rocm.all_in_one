# syntax=docker/dockerfile:1.7

FROM rocm/vllm-dev:rocm7.2_navi_ubuntu24.04_py3.12_pytorch_2.9_vllm_0.14.0rc0

ARG BUNDLED_DATASET_NAME=""
ARG BUNDLED_DATASET_URL=""
ARG PADDLE_PDX_MODEL_SOURCE=bos
ARG PADDLEX_PRETEND_VERSION=0.0.dev0
ARG VLLM_SERVER_PORT=8118
ARG PRECISION_DATASET_URL=""
ARG PRECISION_DATASET_NAME="images"
ARG SPEED_DATASET_URL=""
ARG SPEED_DATASET_NAME="omni1_5_pdfs"
ARG BENCHMARK_ASSET_URL=""
ARG BENCHMARK_ASSET_NAME="ocr-vlm-benchmark-f29cfe4"
ARG PRECISION_DATASET_SHA256=""
ARG SPEED_DATASET_SHA256=""
ARG BENCHMARK_ASSET_SHA256=""

RUN apt-get update \
    && apt-get install -y curl libgl1 rsync tini \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True \
    PADDLE_PDX_MODEL_SOURCE=${PADDLE_PDX_MODEL_SOURCE} \
    PADDLE_PDX_CACHE_HOME=/opt/paddlex/cache \
    PADDLEX_ALL_IN_ONE_CONFIG_DIR=/opt/paddlex/configs \
    PADDLEX_ALL_IN_ONE_DATASET_DIR=/opt/paddlex/datasets \
    PADDLEX_ALL_IN_ONE_BENCHMARK_DIR=/opt/paddlex/benchmarks \
    PADDLEX_ALL_IN_ONE_VLLM_SERVER_PORT=${VLLM_SERVER_PORT} \
    SETUPTOOLS_SCM_PRETEND_VERSION_FOR_PADDLEX=${PADDLEX_PRETEND_VERSION}

WORKDIR /workspace/PaddleX
COPY PaddleX /workspace/PaddleX
COPY extra_data /opt/paddlex/bootstrap

RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install ".[ocr]" \
    && python -m pip install --force-reinstall --no-cache-dir \
        "fsspec==2025.9.0" \
        "numpy==2.2.6" \
        "PyYAML==6.0.2" \
        "scikit-image==0.25.2" \
        "einops" \
        "openai>=1.63" \
        "paddleocr==3.4.0" \
        "paddlepaddle==3.1.1" \
        "setuptools==79.0.1" \
        "transformers<5.0.0" \
        "uvloop"

RUN mkdir -p \
        "${PADDLE_PDX_CACHE_HOME}" \
        "${PADDLEX_ALL_IN_ONE_CONFIG_DIR}" \
        "${PADDLEX_ALL_IN_ONE_DATASET_DIR}" \
        "${PADDLEX_ALL_IN_ONE_BENCHMARK_DIR}" \
    && if [ -d /opt/paddlex/bootstrap/cache ]; then \
        rsync -a /opt/paddlex/bootstrap/cache/ "${PADDLE_PDX_CACHE_HOME}/"; \
    fi \
    && if [ -d /opt/paddlex/bootstrap/datasets ]; then \
        rsync -a /opt/paddlex/bootstrap/datasets/ "${PADDLEX_ALL_IN_ONE_DATASET_DIR}/"; \
    fi \
    && python deploy/genai_vllm_server_docker/prepare_rocm_all_in_one_assets.py \
        --asset-url "${BUNDLED_DATASET_URL}" \
        --asset-name "${BUNDLED_DATASET_NAME}" \
        --asset-sha256 "" \
        --asset-kind dataset \
        --target-root "${PADDLEX_ALL_IN_ONE_DATASET_DIR}" \
    && python deploy/genai_vllm_server_docker/prepare_rocm_all_in_one_assets.py \
        --asset-url "${PRECISION_DATASET_URL}" \
        --asset-name "${PRECISION_DATASET_NAME}" \
        --asset-sha256 "${PRECISION_DATASET_SHA256}" \
        --asset-kind dataset \
        --target-root "${PADDLEX_ALL_IN_ONE_DATASET_DIR}" \
    && python deploy/genai_vllm_server_docker/prepare_rocm_all_in_one_assets.py \
        --asset-url "${SPEED_DATASET_URL}" \
        --asset-name "${SPEED_DATASET_NAME}" \
        --asset-sha256 "${SPEED_DATASET_SHA256}" \
        --asset-kind dataset \
        --target-root "${PADDLEX_ALL_IN_ONE_DATASET_DIR}" \
    && python deploy/genai_vllm_server_docker/prepare_rocm_all_in_one_assets.py \
        --asset-url "${BENCHMARK_ASSET_URL}" \
        --asset-name "${BENCHMARK_ASSET_NAME}" \
        --asset-sha256 "${BENCHMARK_ASSET_SHA256}" \
        --asset-kind benchmark \
        --target-root "${PADDLEX_ALL_IN_ONE_BENCHMARK_DIR}" \
        --required-glob "**/e2e/test_local.py" \
    && python deploy/genai_vllm_server_docker/prepare_rocm_all_in_one.py \
        --pipeline-config paddlex/configs/pipelines/PaddleOCR-VL-1.5.yaml \
        --output-config-dir "${PADDLEX_ALL_IN_ONE_CONFIG_DIR}" \
        --dataset-dir "${PADDLEX_ALL_IN_ONE_DATASET_DIR}" \
        --server-url "http://127.0.0.1:${PADDLEX_ALL_IN_ONE_VLLM_SERVER_PORT}/v1" \
    && rm -rf /opt/paddlex/bootstrap

EXPOSE ${VLLM_SERVER_PORT}

ENTRYPOINT ["tini", "--"]
CMD ["sh", "-lc", "paddlex_genai_server --model_name PaddleOCR-VL-1.5-0.9B --host 0.0.0.0 --port ${PADDLEX_ALL_IN_ONE_VLLM_SERVER_PORT} --backend vllm"]
